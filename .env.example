# Variáveis de ambiente do EmailJS (envio do formulário de contato).
# Copie este arquivo para ".env" e preencha com suas chaves reais.
# As variáveis precisam do prefixo VITE_ para serem expostas no front-end.

VITE_EMAILJS_SERVICE_ID=seu-service-id
VITE_EMAILJS_TEMPLATE_ID=seu-template-id
VITE_EMAILJS_PUBLIC_KEY=sua-public-key
